{
  "name": "free-document-signer",
  "private": true,
  "version": "1.0.0",
  "description": "Sign PDF and Word documents for free in your browser. No account, no tracking.",
  "license": "MIT",
  "repository": "github:shojib068/Signature",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --watch --experimental-strip-types server/index.ts",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server-dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "interactjs": "^1.10.28",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "signature_pad": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
